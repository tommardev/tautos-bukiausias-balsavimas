rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Scoped rules for voting state document
    match /voting/state {
      allow read: if true;
      allow write: if request.resource.data.keys().toSet().hasOnly(['votes', 'customContestants', 'voterLedger', 'updatedAt'])
        && request.resource.data.votes is map
        && request.resource.data.customContestants is list
        && request.resource.data.customContestants.size() <= 50
        && request.resource.data.voterLedger is list
        && request.resource.data.voterLedger.size() <= 100
        && request.resource.data.updatedAt is int;
    }
  }
}
