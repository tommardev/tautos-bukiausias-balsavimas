rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validating the voting state document
    function isValidVotingPayload(data) {
      return data.keys().toSet().hasOnly(['votes', 'customContestants', 'voterLedger', 'updatedAt'])
        && data.votes is map
        && data.votes.size() <= 70
        && data.customContestants is list
        && data.customContestants.size() <= 50
        && data.voterLedger is list
        && data.voterLedger.size() <= 100
        && data.updatedAt is int
        && data.updatedAt > 0;
    }

    // Prevents overwriting with stale timestamps or stripping existing candidate keys
    function isSafeUpdate(currentDoc, incomingDoc) {
      return currentDoc == null || (
        incomingDoc.updatedAt >= currentDoc.data.updatedAt
        && incomingDoc.votes.keys().toSet().hasAll(currentDoc.data.votes.keys().toSet())
      );
    }

    // Scoped rules for voting state documents (production 'state' and development 'state_dev')
    match /voting/{docId} {
      allow read: if docId in ['state', 'state_dev'];
      allow write: if docId in ['state', 'state_dev']
        && isValidVotingPayload(request.resource.data)
        && isSafeUpdate(resource, request.resource.data);
    }
  }
}
